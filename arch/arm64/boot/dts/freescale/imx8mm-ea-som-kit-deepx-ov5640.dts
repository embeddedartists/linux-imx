/* For using onboard DeepX module with mipi camera OV5640.
   PCIe on Carrier Board not available.
   SDIO in M.2 key E connector on Carrier Board not available.
*/
/dts-v1/;

#include "imx8mm-ea-som-kit-deepx.dts"

/ {

	regulators {
		compatible = "simple-bus";

		reg_vref_1v8: regulator-vref-1v8 {
			compatible = "regulator-fixed";
			regulator-name = "vref-1v8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		reg_vref_2v5: regulator-vref-2v5 {
			compatible = "regulator-fixed";
			regulator-name = "vref-2v5";
			regulator-min-microvolt = <2500000>;
			regulator-max-microvolt = <2500000>;
		};

		reg_vref_3v3: regulator-vref-3v3 {
			compatible = "regulator-fixed";
			regulator-name = "vref-3v3";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
		};
	};
};

&csi1_bridge {
	fsl,mipi-mode;
	status = "okay";
	port {
		csi1_ep: endpoint {
			remote-endpoint = <&csi1_mipi_ep>;
		};
	};
};

&mipi_csi_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	port {
		mipi1_sensor_ep: endpoint@1 {
			remote-endpoint = <&ov5640_mipi1_ep>;
			data-lanes = <2>;
			csis-hs-settle = <13>;
			csis-clk-settle = <2>;
			csis-wclk;
		};

		csi1_mipi_ep: endpoint@2 {
			remote-endpoint = <&csi1_ep>;
		};
	};
};


&i2c1 {
	ov5640_mipi: ov5640_mipi@3c {
		compatible = "ovti,ov5640_mipi";
		reg = <0x3c>;
		status = "okay";
		clocks = <&clk IMX8MM_CLK_DUMMY>;
		clock-names = "csi_mclk";
		csi_id = <0>;

		AVDD-supply = <&reg_vref_2v5>;
		DVDD-supply = <&reg_vref_3v3>;
		DOVDD-supply = <&reg_vref_1v8>;

		pwn-gpios = <&pcal6524_u6 1 GPIO_ACTIVE_HIGH>;  /* CSI0_PWR-CLK */
		rst-gpios = <&pcal6524_u6 0 GPIO_ACTIVE_HIGH>;  /* CSI0_RST-DATA */
		mclk = <12000000>;
		mclk_source = <0>;
		port {
			ov5640_mipi1_ep: endpoint {
				remote-endpoint = <&mipi1_sensor_ep>;
			};
		};
	};
};

&pcal6524_u6 {
	/delete-node/ hog_CSI0_RST_DATA;
	/delete-node/ hog_CSI0_PWR_CLK;
};
