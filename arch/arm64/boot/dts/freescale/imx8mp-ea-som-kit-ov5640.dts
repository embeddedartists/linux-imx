/* For using onboard DeepX module. PCIe on Carrier Board not available. */

/dts-v1/;

#include "imx8mp-ea-som-kit.dts"

/ {

	regulators {
		compatible = "simple-bus";

		reg_vref_1v8: regulator-vref-1v8 {
			compatible = "regulator-fixed";
			regulator-name = "vref-1v8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		reg_vref_2v5: regulator-vref-2v5 {
			compatible = "regulator-fixed";
			regulator-name = "vref-2v5";
			regulator-min-microvolt = <2500000>;
			regulator-max-microvolt = <2500000>;
		};

		reg_vref_3v3: regulator-vref-3v3 {
			compatible = "regulator-fixed";
			regulator-name = "vref-3v3";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
		};
	};
};

&mipi_csi_0 {
	status = "okay";

	port {
		mipi_csi0_ep: endpoint {
			remote-endpoint = <&ov5640_mipi_0_ep>;
			data-lanes = <2>;
			csis-hs-settle = <13>;
			csis-clk-settle = <2>;
			csis-wclk;
		};
	};
};

&i2c1 {
	camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		status = "okay";
		clocks = <&clk IMX8MP_CLK_IPP_DO_CLKO2>;
		clock-names = "xclk";
		assigned-clocks = <&clk IMX8MP_CLK_IPP_DO_CLKO2>;
		assigned-clock-parents = <&clk IMX8MP_CLK_24M>;
		assigned-clock-rates = <24000000>;
		csi_id = <0>;

		AVDD-supply = <&reg_vref_2v5>;
		DVDD-supply = <&reg_vref_3v3>;
		DOVDD-supply = <&reg_vref_1v8>;

		powerdown-gpios = <&pcal6524_u6 1 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pcal6524_u6 0 GPIO_ACTIVE_LOW>;
		mclk = <12000000>;
		mclk_source = <0>;
		mipi_csi;
		port {
			ov5640_mipi_0_ep: endpoint {
				remote-endpoint = <&mipi_csi0_ep>;
				data-lanes = <1 2>;
				clock-lanes = <0>;
			};
		};
	};
};

&pcal6524_u6 {
	/delete-node/ hog_CSI0_RST_DATA;
	/delete-node/ hog_CSI0_PWR_CLK;
};

